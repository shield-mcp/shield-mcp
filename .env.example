# Base mainnet RPC (one is fine; public default works)
SHIELD_RPC_URLS=https://mainnet.base.org

# Dedicated agent wallet private key. shield//mcp derives the shielded keypair
# from a signature by this key. This wallet also funds shields + gas. Keep secret.
SHIELD_PRIVATE_KEY=

# Optional: where the local shielded-state cache lives (default ~/.shield-mcp/)
SHIELD_CACHE_PATH=
