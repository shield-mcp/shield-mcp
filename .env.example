# --- Network (Base mainnet) ---
# Comma-separated RPC URLs. First is used for sending. Public default works:
SHIELD_RPC_URLS=https://mainnet.base.org

# --- Agent wallet ---
# EOA private key. Hinkal derives the shielded keypair from a signature by this
# key. This EOA also funds shields + pays gas (unless relayed). Use a dedicated
# key. Required.
SHIELD_PRIVATE_KEY=

# --- Storage ---
# Hinkal file cache (merkle/UTXO state). Default: ~/.shield-mcp/hinkal-cache.json
SHIELD_CACHE_PATH=

# --- Private swap routing (Odos) ---
# private_swap works out of the box with NO key here: the client fetches the DEX
# route from the hosted helper, which returns PUBLIC calldata only — your private
# key and funds never touch it. Set your OWN Odos key (free at docs.odos.xyz) ONLY
# if you want zero third-party dependency / to self-host the route path.
ODOS_API_KEY=
# Override the hosted route helper (default: https://shieldmcp.sh/api/route).
# Point this at your own deployment of the helper if you self-host it.
SHIELD_ODOS_ROUTE_URL=

# --- Policy guard (bounds an autonomous agent — strongly recommended) ---
# Without these, the agent can move funds to any recipient up to the wallet balance.
# Comma-separated addresses transfer/unshield may send to (the #1 anti-drain control):
SHIELD_RECIPIENT_ALLOWLIST=
# Max amount per op, in base units (wei). e.g. 5 USDC = 5000000:
SHIELD_MAX_PER_TX=
# Max fund-moving ops per rolling 24h:
SHIELD_MAX_OPS_PER_DAY=

# --- Settlement retry (relayed-note sync lag) ---
# A spend right after a relayed op can fail with "insufficient funds" while the new
# note is still confirming in the anonymity set. The client retries ONLY that
# pre-broadcast shortfall (re-syncing each time) — never a broadcast-class error,
# so no double-spend. Tune the attempts / backoff (defaults: 3 retries, 12s):
SHIELD_SETTLE_RETRIES=
SHIELD_SETTLE_BACKOFF_MS=
